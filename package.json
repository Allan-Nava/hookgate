{
  "name": "hookgate",
  "version": "0.0.3",
  "description": "Calibrated, sub-second decisions in Claude Code's hooks: a PreToolUse gate on shell commands and a Stop gate on unverified completion, answered by TypeSafe's Jev with a confidence score, escalating to the human when unsure.",
  "type": "module",
  "bin": {
    "hookgate": "bin/hookgate.mjs"
  },
  "files": [
    "bin",
    "hooks",
    "codex",
    ".claude-plugin",
    ".codex-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:site": "node site/build.mjs",
    "test": "node bin/hookgate.mjs check && node --test",
    "scorecard": "node evals/scorecard.mjs",
    "backlog": "npx --yes backlogsync@0.1.1 check",
    "roadmap": "npx --yes backlogsync@0.1.1 roadmap"
  },
  "backlogsync": {
    "prefix": "HG",
    "name": "hookgate",
    "regenerate": "npm run roadmap",
    "labels": {
      "gate": [
        "b7552f",
        "A hook gate"
      ],
      "benchmark": [
        "0e8a16",
        "Measurement and evals"
      ],
      "release": [
        "5319e7",
        "Publishing and versioning"
      ],
      "docs": [
        "0075ca",
        "README, CONTRIBUTING, site"
      ],
      "project": [
        "6a737d",
        "Backlog, roadmap, repo hygiene"
      ],
      "tests": [
        "d4c5f9",
        "Test coverage and test tooling"
      ],
      "enhancement": [
        "a2eeef",
        "New capability"
      ]
    }
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "hooks",
    "guardrails",
    "typesafe",
    "system-one",
    "calibrated-confidence",
    "agent-safety"
  ],
  "author": "Allan Nava (https://github.com/Allan-Nava)",
  "license": "MIT",
  "homepage": "https://github.com/Allan-Nava/hookgate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allan-Nava/hookgate.git"
  },
  "bugs": {
    "url": "https://github.com/Allan-Nava/hookgate/issues"
  },
  "devDependencies": {
    "marked": "^18.0.0"
  }
}
